LLM_PROVIDER=infercom               # infercom | google | groq | mistral
LLM_MODEL=                          # порожньо = перевірена модель за замовчуванням з model.ts (infercom: gpt-oss-120b)
LLM_FALLBACK_PROVIDER=google,groq,mistral  # резерв по черзі; провайдер без ключа пропускається
LLM_FALLBACK_MODEL=                 # порожньо = моделі за замовчуванням з model.ts
INFERCOM_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=                     # не використовується (платний) — без ключа пропускається
LLM_MOCK=0                          # 1 = скриптований стрім без LLM (розробка UI)
GEO_IMPL=real                       # mock | real
RATE_LIMIT_PER_MIN=10
