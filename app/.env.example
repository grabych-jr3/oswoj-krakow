LLM_PROVIDER=google                 # google | mistral | groq
LLM_MODEL=gemini-3.5-flash-lite        # більша безкоштовна квота, ніж у Flash; з інструментами працює добре (перевірено 21.10.2026)
LLM_FALLBACK_PROVIDER=groq          # безкоштовний резерв (Mistral не використовуємо — платний)
LLM_FALLBACK_MODEL=openai/gpt-oss-120b  # llama-3.3-70b-versatile у Groq більше немає
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=                     # не використовується
GROQ_API_KEY=
LLM_MOCK=0                          # 1 = скриптований стрім без LLM (розробка UI)
GEO_IMPL=real                       # mock | real
RATE_LIMIT_PER_MIN=10
